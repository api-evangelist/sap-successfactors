  "info": {
    "_postman_id": "04db4051-c3e3-4b7d-86dc-0e5bc971ace7",
    "name": "SAP SuccessFactors HXM Suite OData EmpEmployment Oauth API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Representative subset of the SAP SuccessFactors HXM Suite OData APIs\n(v2 and v4) covering common Employee Central entities such as User,\nPerPerson, EmpEmployment, EmpJob, and FOCompany. Authentication uses\nOAuth 2.0 SAML bearer assertion or HTTP Basic against the tenant's\nOData service root.\n\n\nContact Support:\n Name: SAP SuccessFactors",
      "type": "text/plain"
    }
